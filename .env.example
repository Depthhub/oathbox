# Copy to .env and fill in. Never commit .env.

# NEAR AI Cloud key (claim $10 at https://nearbuilders.org/join -> dashboard)
NEARAI_API_KEY=

# TEE model: must be a "Confidential TEE" model that returns model_attestations[].
# Chosen on Day 1 from GET https://cloud-api.near.ai/v1/models + the catalog.
MODEL_ID=

# NEAR testnet signer (the data-room owner / backend account)
NEAR_ACCOUNT_ID=
NEAR_PRIVATE_KEY=

# Deployed Oathbox contract on testnet
CONTRACT_ID=

# Optional overrides
NEAR_RPC_URL=https://rpc.testnet.near.org
NEARAI_BASE_URL=https://cloud-api.near.ai
DATAROOM_DIR=sample-dataroom
