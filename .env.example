# Copy to .env and fill in the three blanks. Never commit .env.

# NEAR AI Cloud API key (free credits: https://nearbuilders.org/join -> dashboard)
NEARAI_API_KEY=

# The server's NEAR testnet account. It records receipts (and seals the bundled
# sample room). Needs about 1 testnet NEAR. Must end in .testnet.
NEAR_ACCOUNT_ID=
NEAR_PRIVATE_KEY=

# The deployed Oathbox contract. Keep this to use the live one, or deploy your own
# with scripts/deploy_contract.py and put its id here.
CONTRACT_ID=oathbox.builtbysammy.testnet
NEAR_NETWORK=testnet

# TEE model on NEAR AI Cloud (must be on the allow-list in backend/oathbox/tee.py)
MODEL_ID=Qwen/Qwen3.6-35B-A3B-FP8

# The bundled sample room is sealed by YOUR server account the first time you run
# scripts/e2e.py. Room ids are global on the contract, so pick a unique one.
SAMPLE_ROOM_ID=ledgerlight-yourname

# Optional
NEAR_RPC_URL=https://rpc.testnet.near.org
NEARAI_BASE_URL=https://cloud-api.near.ai
DATAROOM_DIR=sample-dataroom
# OATHBOX_SESSION_SECRET=   # signs founder sessions; a random one is created in .oathbox/ if unset
